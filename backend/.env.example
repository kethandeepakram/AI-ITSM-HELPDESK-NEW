# ==============================================================================
# SORIM.Ai Technical Hackathon Assessment - Environment Configuration
# ==============================================================================

# MongoDB Atlas (optional for local exploration; in-memory fallback is not durable)
MONGODB_URI=
MONGODB_DATABASE=itsm_helpdesk

# Free/public Hugging Face model executed locally with Transformers.
# Public model weights download on first use; several GB of disk/RAM may be needed.
# No hosted Hugging Face inference token or credits are required for local inference.
LLM_PROVIDER=transformers
HF_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_MAX_NEW_TOKENS=220
HF_TOKEN=

# Chroma vector store
CHROMA_PERSIST_DIRECTORY=chroma_data
CHROMA_COLLECTION_NAME=itsm_knowledge_chunks

# ServiceNow (mock mode is acceptable if a live developer instance is unavailable)
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_MOCK_MODE=true

# AI Safety & Governance
CONFIDENCE_THRESHOLD=0.65
DEBUG=false

# Browser origins allowed to call the API; comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
