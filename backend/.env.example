# ==============================================================================
# SORIM.Ai Technical Hackathon Assessment - Environment Configuration
# ==============================================================================

# 1. MongoDB Atlas Configuration (Optional - falls back to local storage if empty)
MONGODB_URI=
MONGODB_DATABASE=itsm_helpdesk

# 2. Hugging Face Configuration (Optional - falls back to local NLP & embeddings if empty)
HF_TOKEN=
HF_LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# 3. ServiceNow Integration (Optional - falls back to realistic Mock ServiceNow API if empty)
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_MOCK_MODE=true

# 4. AI Safety & Governance
CONFIDENCE_THRESHOLD=0.65
DEBUG=false

# Browser origins allowed to call the API; comma-separated for deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
