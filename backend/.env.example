# ==============================================================================
# SORIM.Ai Technical Hackathon Assessment - Environment Configuration
# ==============================================================================

# 1. MongoDB Atlas Configuration (Optional - falls back to local storage if empty)
MONGODB_URI=
MONGODB_DATABASE=itsm_helpdesk

# 2. LLM configuration.
# Option B defaults to a local Ollama model and does not need an inference API token.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=45

# Optional hosted Hugging Face inference. Used only with LLM_PROVIDER=huggingface.
HF_TOKEN=
HF_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chroma vector store (persistent local index)
CHROMA_PERSIST_DIRECTORY=chroma_data
CHROMA_COLLECTION_NAME=itsm_knowledge_chunks

# 3. ServiceNow Integration (Optional - falls back to realistic Mock ServiceNow API if empty)
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_MOCK_MODE=true

# 4. AI Safety & Governance
CONFIDENCE_THRESHOLD=0.65
DEBUG=false

# Browser origins allowed to call the API; comma-separated for deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
